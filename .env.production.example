# Production Environment Variables
# Copy this to .env.production and fill in your actual values

# Flask/App Settings
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://username:password@db-server:5432/fabricators_prod

# LLM Configuration (from testing results)
PROD_LLM_PROVIDER=unsloth
PROD_MODEL_NAME=meta-llama/Llama-2-7b-hf
PROD_MAX_TOKENS=512
PROD_TEMPERATURE=0.7

# CORS Settings (restrict to your domain)
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# API Keys
UNSLOTH_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
