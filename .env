# Development Environment Variables

# Application
APP_NAME=Fabricators AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./fabricators_dev.db

# LLM Provider
LLM_PROVIDER=mock
MODEL_NAME=meta-llama/Llama-2-7b-hf
MAX_TOKENS=1024
TEMPERATURE=0.7

# 3D Generation
GENERATION_3D_ENABLED=True
PRIMARY_3D_FORMAT=gltf
SECONDARY_3D_FORMAT=stl

# Report Generation
PDF_ENABLED=False
INCLUDE_3D_PREVIEW_IN_PDF=True
